# Copie para .env e ajuste. O .env NÃO é versionado.
# SECRET_KEY vazio usa o default de desenvolvimento; em produção é obrigatório.
SECRET_KEY=
DATABASE_URI=sqlite:///tasks.db
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
TOKEN_TTL_HORAS=8
AMBIENTE=desenvolvimento
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true protege rotas com Bearer token (quebra o contrato legado).
AUTH_REQUIRED=false
