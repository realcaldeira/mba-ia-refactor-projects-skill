# Copie para .env e ajuste. O .env NÃO é versionado.
PORT=3000
HOST=127.0.0.1
NODE_ENV=desenvolvimento
DB_PATH=:memory:
SEED_ON_BOOT=true
LOG_LEVEL=info
# Vazio usa o default de desenvolvimento; em production é obrigatório.
SECRET_KEY=
TOKEN_TTL_HORAS=8
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_URL=
SMTP_USER=
SMTP_PASS=
# true protege relatório admin e DELETE com Bearer token (quebra o contrato legado).
AUTH_REQUIRED=false
