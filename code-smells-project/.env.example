# Copie para .env e ajuste. O .env NÃO é versionado.
# SECRET_KEY vazio usa o default de desenvolvimento; em produção é obrigatório.
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DB_PATH=loja.db
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
TOKEN_TTL_HORAS=8
AMBIENTE=desenvolvimento
# true protege mutações e dados sensíveis com Bearer token (quebra o contrato legado).
AUTH_REQUIRED=false
